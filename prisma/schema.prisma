// COD Flow Tracker schema.
// SQLite in development; every type used here is PostgreSQL-compatible
// (switch `provider` to "postgresql" and regenerate migrations for production).
// Money is always stored as integer minor units with a currency code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  OWNER
  ADMIN
  ANALYST
  OPERATOR
}

enum IntegrationProvider {
  MDM_EXPRESS
  /// Meta Marketing API (ad spend). The credential is a system-user access token.
  META_ADS
}

enum ConnectionStatus {
  NOT_CONFIGURED
  /// Credential saved but no successful read-only test yet.
  UNTESTED
  CONNECTED
  ERROR
  DISABLED
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELED
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  RETRY
}

enum SyncItemResult {
  ADDED
  UPDATED
  UNCHANGED
  FAILED
  UNMATCHED
  SKIPPED
}

enum NormalizedStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  LOST
  CANCELED
  EXCHANGED
  UNKNOWN
}

enum OrderSource {
  SHOPIFY
  EASYSELL
  MANUAL
  OTHER
  /// Read from MDM Express by the sync.
  MDM_EXPRESS
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum MatchMethod {
  ORDER_REFERENCE
  TRACKING_ID
  SOURCE_ORDER_ID
  MANUAL
  NONE
  /// The parcel's MDM order is this order (MDM's own link).
  MDM_ORDER
}

enum AttributionMethod {
  UTM_CONTENT
  MANUAL
  NONE
}

enum AdPlatform {
  META
  TIKTOK
  OTHER
}

enum ExpenseCategory {
  AI_TOOLS
  SOFTWARE
  OFFICE
  DOMAINS_PROXIES
  BANK_FEES
  CALL_CENTER
  PACKAGING
  WAREHOUSE
  OTHER
  SALARIES
  OTHER_ADS
  CONTENT
  TRANSPORT
  TAXES
  /// What the owner takes for themself. Employee pay is SALARIES. Both count as expenses.
  OWNER_PAY
}

enum ExpenseFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ExpenseAllocation {
  GLOBAL
  PRODUCT
}

enum CostType {
  FIXED
  VARIABLE
}

enum BankReviewStatus {
  PENDING
  CATEGORIZED
  EXCLUDED
}

enum ImportKind {
  ORDERS
  AD_SPEND
  EXPENSES
  BANK
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  PARTIAL
  FAILED
}

enum CashEventType {
  COD_COLLECTED
  REMITTED
  CARRIER_FEE
  ADJUSTMENT
}

enum ReviewStatus {
  OPEN
  RESOLVED
  IGNORED
}

// ─────────────────────── Identity & tenancy ───────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  /// Currency every stored amount is kept in. Fixed at creation.
  currency          String   @default("DZD")
  /// Currency reports and totals are shown in, converted with `exchangeRates`. Null = `currency`.
  reportCurrency    String?
  timezone          String   @default("Africa/Algiers")
  isDemo            Boolean  @default(false)
  /// Zod-validated JSON: fees, call-center basis, overhead allocation policy.
  economicsDefaults Json?
  /// Zod-validated JSON: verdict thresholds (min sample, target POAS, delivery/RTO limits).
  verdictThresholds Json?
  /// Zod-validated JSON: units of `currency` per 1 unit of another currency, e.g. {"USD": 250}.
  /// Pre-fills forms; each saved amount keeps the rate it was converted with.
  exchangeRates     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members           WorkspaceMember[]
  auditLogs         AuditLog[]
  connections       IntegrationConnection[]
  syncJobs          SyncJob[]
  syncItems         SyncItem[]
  rawRecords        RawExternalRecord[]
  statusMappings    StatusMapping[]
  unmatchedRecords  UnmatchedRecord[]
  products          Product[]
  costVersions      ProductCostVersion[]
  orders            Order[]
  orderLines        OrderLine[]
  attributions      Attribution[]
  parcels           Parcel[]
  parcelEvents      ParcelStatusEvent[]
  cashEvents        CashEvent[]
  mdmAccount        MdmAccount?
  mdmPayouts        MdmPayout[]
  mdmFees           MdmFee[]
  mdmStock          MdmStockItem[]
  mdmArrivals       MdmStockArrival[]
  mdmProductLinks   MdmProductLink[]
  mdmProductChoices MdmProductChoice[]
  mdmSkippedOrders  MdmSkippedOrder[]
  profitPlans       ProfitPlan[]
  expenseCategories CustomExpenseCategory[]
  recurringExpenses RecurringExpense[]
  creatives         Creative[]
  adSpend           AdSpend[]
  adAccounts        AdAccount[]
  campaigns         Campaign[]
  metaTokens        MetaToken[]
  expenses          Expense[]
  bankTransactions  BankTransaction[]
  importBatches     ImportBatch[]
  importRowErrors   ImportRowError[]
  metricSnapshots   MetricSnapshot[]
  scenarios         SimulatorScenario[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  /// Never contains credentials; sanitized before write.
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action])
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

// ───────────────────────── MDM integration ─────────────────────────

model IntegrationConnection {
  id                    String              @id @default(uuid())
  workspaceId           String
  provider              IntegrationProvider
  baseUrl               String              @default("https://api.mdm.express")
  /// AES-256-GCM envelope "v1:<iv>:<tag>:<ciphertext>" (base64). Never sent to the browser.
  encryptedCredential   String?
  keyVersion            Int?
  /// e.g. "••••1a2b". Safe to display.
  maskedLabel           String?
  status                ConnectionStatus    @default(NOT_CONFIGURED)
  lastTestedAt          DateTime?
  lastSuccessfulSyncAt  DateTime?
  /// Last successful sync that also read MDM orders. Until one has run, the next sync re-reads
  /// every parcel once so parcels synced earlier get linked to their MDM orders.
  ordersSyncedAt        DateTime?
  /// Meta only: held while a spend sync runs, so two never overlap.
  syncLeaseUntil        DateTime?
  lastSyncAttemptAt     DateTime?
  /// Meta only: what the last spend sync read (accounts, rows, days, per-account errors).
  lastSyncSummary       Json?
  lastError             String?
  syncIntervalMinutes   Int                 @default(45)
  /// MDM only: whether products MDM sends for the first time are brought in, or wait until someone picks them.
  bringNewMdmProducts   Boolean             @default(true)
  /// MDM only: when someone last chose to bring in more (a product turned on, or older days).
  /// The next regular sync after it re-reads every MDM order once to fetch them.
  choicesWidenedAt      DateTime?
  credentialUpdatedAt   DateTime?
  credentialUpdatedById String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

model SyncJob {
  id                     String              @id @default(uuid())
  workspaceId            String
  provider               IntegrationProvider
  status                 SyncJobStatus       @default(QUEUED)
  trigger                SyncTrigger         @default(MANUAL)
  requestedById          String?
  cancelRequested        Boolean             @default(false)
  startedAt              DateTime?
  finishedAt             DateTime?
  cursor                 String?
  page                   Int                 @default(0)
  totalCount             Int?
  addedCount             Int                 @default(0)
  updatedCount           Int                 @default(0)
  unchangedCount         Int                 @default(0)
  failedCount            Int                 @default(0)
  unknownStatusCount     Int                 @default(0)
  unmatchedCount         Int                 @default(0)
  /// "ORDERS" (MDM orders are read first), then "PARCELS", then "ACCOUNT" (wallet, fees, payouts, stock). Resumed jobs continue in the saved phase.
  phase                  String              @default("PARCELS")
  ordersAddedCount       Int                 @default(0)
  ordersUpdatedCount     Int                 @default(0)
  /// Orders read in this sync that carry a content ID (utm_content).
  ordersWithContentCount Int                 @default(0)
  /// Why orders were not (fully) read, e.g. the API key has no order access. Not an error.
  ordersNote             String?
  error                  String?
  heartbeatAt            DateTime?
  /// FULL re-reads everything; INCREMENTAL asks for parcels updated since the last success (minus an overlap);
  /// CUSTOM reads only the orders matching `filters` (and their parcels), and never moves the incremental starting point.
  mode                   String              @default("INCREMENTAL")
  /// A custom sync's choices (src/domain/customSync.ts), with the day range resolved to instants. Null for other syncs.
  filters                Json?
  /// Orders a custom sync found matching its filters (new, updated or already up to date).
  ordersMatchedCount     Int                 @default(0)
  /// Orders a custom sync read from MDM but left alone because they didn't match its filters.
  skippedCount           Int                 @default(0)
  /// "mock" (labelled demo fixtures) or "live".
  adapter                String              @default("mock")
  updatedSince           DateTime?
  /// Whole-job retry after a retryable provider failure (429/5xx/network).
  attempt                Int                 @default(0)
  nextRunAt              DateTime?
  retryOfJobId           String?
  /// "<workspaceId>:<provider>" while QUEUED or RUNNING, null once finished. The unique index is the per-workspace sync lock.
  activeLock             String?             @unique
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     SyncItem[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([status, nextRunAt])
}

model SyncItem {
  id          String         @id @default(uuid())
  workspaceId String
  jobId       String
  entityType  String
  providerId  String
  localId     String?
  result      SyncItemResult
  error       String?
  retryCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  job       SyncJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([workspaceId, result])
  @@index([jobId])
}

model RawExternalRecord {
  id          String              @id @default(uuid())
  workspaceId String
  provider    IntegrationProvider
  entityType  String
  externalId  String
  payload     Json
  payloadHash String
  observedAt  DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, entityType, externalId, payloadHash])
  @@index([workspaceId, provider, externalId])
  @@index([observedAt])
}

model StatusMapping {
  id               String              @id @default(uuid())
  workspaceId      String
  provider         IntegrationProvider
  providerStatus   String
  normalizedStatus NormalizedStatus
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, providerStatus])
}

model UnmatchedRecord {
  id           String              @id @default(uuid())
  workspaceId  String
  provider     IntegrationProvider
  entityType   String
  externalId   String
  reference    String?
  reason       String
  status       ReviewStatus        @default(OPEN)
  parcelId     String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parcel    Parcel?   @relation(fields: [parcelId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, provider, entityType, externalId])
  @@index([workspaceId, status])
}

// ─────────────────────── Commerce & fulfillment ───────────────────────

model Product {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  sku         String
  currency    String   @default("DZD")
  active      Boolean  @default(true)
  /// Created by the MDM sync for a product MDM sent with an order. Its costs are entered by hand.
  fromMdm     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mdmLinks          MdmProductLink[]
  profitPlan        ProfitPlan?
  recurringExpenses RecurringExpense[]
  costVersions      ProductCostVersion[]
  orderLines        OrderLine[]
  creatives         Creative[]
  expenses          Expense[]
  scenarios         SimulatorScenario[]
  campaigns         Campaign[]
  adAccounts        AdAccount[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, active])
}

/// Which product in the app each MDM product counts as. The sync adds one the first time MDM sends a
/// product with an order (linking an existing product, or creating one); an owner can move it to another product.
/**
 * Which MDM products the sync brings in, and from which day. MDM products with no row follow
 * IntegrationConnection.bringNewMdmProducts. Orders already in the app keep updating either way.
 */
model MdmProductChoice {
  workspaceId  String
  /// MDM's product ID (for a variant, the product it is a variant of).
  mdmProductId String
  /// MDM's name for the product, as last seen.
  name         String?
  /// False: MDM orders with only this product (or products not brought in) are skipped.
  bring        Boolean   @default(true)
  /// Orders placed before this day are skipped. Null: every order.
  since        DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, mdmProductId])
}

/// MDM orders the sync skipped because of the product choices, so their parcels are skipped too.
model MdmSkippedOrder {
  workspaceId String
  mdmOrderId  String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, mdmOrderId])
}

model MdmProductLink {
  workspaceId  String
  /// MDM's product ID (for a variant, the product it is a variant of).
  mdmProductId String
  productId    String
  /// MDM's name for the product, as last seen on an order.
  mdmName      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([workspaceId, mdmProductId])
  @@index([productId])
}

/// What the Profit tracker counts for one product, once an owner or admin saved it: where the stock
/// count comes from, and the values typed over the ones read from the data.
model ProfitPlan {
  productId   String   @id
  workspaceId String
  /// MDM_AVAILABLE, MDM_WITH_INCOMING, MDM_RECEIVED or TYPED (src/domain/profitTracker.ts).
  stockSource String   @default("MDM_AVAILABLE")
  /// The units typed in, for TYPED.
  stockUnits  Int?
  /// { salePrice?, unitCost?, deliveryRate?, cpa?, … }: only the values someone typed.
  overrides   Json?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Immutable history of unit-economics assumptions. Never updated in place;
/// a new version closes the previous one by setting its effectiveTo.
model ProductCostVersion {
  id                   String    @id @default(uuid())
  workspaceId          String
  productId            String
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  salePrice            Int
  sourcingCost         Int
  forwardShippingFee   Int
  rtoFee               Int
  callCenterFee        Int
  packagingFee         Int
  currency             String    @default("DZD")
  /// Set when the sourcing cost was entered in another currency: the amount as entered (minor
  /// units of sourcingCurrency) and the rate used. sourcingCost is always in `currency`.
  sourcingCostOriginal Int?
  sourcingCurrency     String?
  sourcingFxRate       Float?
  note                 String?
  createdById          String?
  createdAt            DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, productId, effectiveFrom])
  @@index([effectiveFrom])
}

model Order {
  id                    String      @id @default(uuid())
  workspaceId           String
  source                OrderSource
  externalOrderId       String
  orderNumber           String
  normalizedOrderNumber String
  placedAt              DateTime
  status                OrderStatus @default(PENDING)
  confirmedAt           DateTime?
  canceledAt            DateTime?
  /// Call-center attempts, used when the call-center cost basis is CALL_ATTEMPT.
  callAttempts          Int?
  /// SHA-256 of normalized phone (salted per workspace). Raw phone is never stored.
  phoneHash             String?
  phoneMasked           String?
  customerRef           String?
  wilaya                String?
  city                  String?
  codAmount             Int
  currency              String      @default("DZD")
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  tags                  String?
  notes                 String?
  importBatchId         String?
  /// MDM's order tracking ID (e.g. ORD-XXXXXX) once the sync has read this order from MDM.
  mdmOrderId            String?
  /// MDM's own status for this order as the sync last read it (e.g. "not-answered"), and when MDM set it.
  mdmStatus             String?
  mdmStatusAt           DateTime?
  /// The customer's name, phones and street address from MDM, AES-256-GCM encrypted with
  /// APP_ENCRYPTION_KEY (src/server/customers.ts). Only readable server-side, by roles allowed to see customers.
  customerEncrypted     String?
  customerKeyVersion    Int?
  /// "HOME" or "STOP_DESK", as MDM gave it.
  deliveryType          String?
  /// The store MDM received the order from.
  storeName             String?
  /// When the sync last looked for a content ID in this order's MDM status history.
  mdmHistoryCheckedAt   DateTime?
  /// MDM marks the order as upsold by its call center (read with MDM's upsell filter).
  mdmUpsell             Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines       OrderLine[]
  attribution Attribution?
  parcels     Parcel[]
  cashEvents  CashEvent[]
  mdmFees     MdmFee[]
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, source, externalOrderId])
  @@unique([workspaceId, mdmOrderId])
  @@index([workspaceId, normalizedOrderNumber])
  @@index([workspaceId, placedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, wilaya])
  @@index([confirmedAt])
}

model OrderLine {
  id           String  @id @default(uuid())
  workspaceId  String
  orderId      String
  productId    String?
  sku          String?
  productName  String?
  quantity     Int
  unitPrice    Int
  currency     String  @default("DZD")
  /// MDM's product ID for this line (for a variant, the product it is a variant of), and the variant's own ID.
  mdmProductId String?
  mdmVariantId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, productId])
  @@index([workspaceId, mdmProductId])
  @@index([orderId])
}

model Attribution {
  id                    String            @id @default(uuid())
  workspaceId           String
  orderId               String            @unique
  creativeId            String?
  /// Denormalized for the creative + order-date index.
  orderPlacedAt         DateTime
  rawUtmContent         String?
  normalizedCreativeKey String?
  method                AttributionMethod @default(NONE)
  confidence            Float             @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creative  Creative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, creativeId, orderPlacedAt])
}

model Parcel {
  id                   String              @id @default(uuid())
  workspaceId          String
  orderId              String?
  provider             IntegrationProvider
  trackingId           String
  providerReference    String?
  /// Store order ID the carrier echoed back (e.g. Shopify/EasySell ID), used as the third matching key.
  sourceOrderId        String?
  /// MDM's tracking ID of the order this parcel ships (MDM's own parcel → order link).
  mdmOrderId           String?
  providerStatus       String?
  normalizedStatus     NormalizedStatus    @default(UNKNOWN)
  codAmount            Int                 @default(0)
  currency             String              @default("DZD")
  shippingFee          Int?
  returnFee            Int?
  wilaya               String?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  returnedAt           DateTime?
  lastProviderUpdateAt DateTime?
  matchMethod          MatchMethod         @default(NONE)
  matchConfidence      Float               @default(0)
  isDemoFixture        Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  events     ParcelStatusEvent[]
  cashEvents CashEvent[]
  mdmFees    MdmFee[]
  unmatched  UnmatchedRecord[]

  @@unique([workspaceId, provider, trackingId])
  @@index([workspaceId, normalizedStatus])
  @@index([workspaceId, wilaya])
  @@index([workspaceId, orderId])
  @@index([workspaceId, mdmOrderId])
  @@index([dispatchedAt])
  @@index([deliveredAt])
  @@index([returnedAt])
}

/// Append-only. Deduplicated by (parcelId, eventHash).
model ParcelStatusEvent {
  id               String           @id @default(uuid())
  workspaceId      String
  parcelId         String
  providerStatus   String
  normalizedStatus NormalizedStatus
  occurredAt       DateTime
  source           String           @default("MDM_EXPRESS")
  eventHash        String
  createdAt        DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parcel    Parcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([parcelId, eventHash])
  @@index([workspaceId, occurredAt])
}

model CashEvent {
  id          String        @id @default(uuid())
  workspaceId String
  type        CashEventType
  parcelId    String?
  orderId     String?
  amount      Int
  currency    String        @default("DZD")
  occurredAt  DateTime
  externalRef String?
  note        String?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parcel    Parcel?   @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, externalRef])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, type])
}

// ─────────────────────── Marketing & finance ───────────────────────

// ─────────────────────────── MDM money and stock (read-only copies) ───────────────────────────

/// What the last syncs read from the workspace's MDM account beyond orders and parcels: the
/// wallet, MDM's price list and the stock value. One row per workspace. Amounts are minor units.
model MdmAccount {
  workspaceId     String    @id
  /// MDM's ID for the seller, needed to read the price list.
  sellerId        String?
  /// { currency, onHold, ready, paid, details } (src/server/mdm/account.ts).
  wallet          Json?
  walletAt        DateTime?
  /// Call center, fulfilment and delivery prices MDM charges this seller.
  prices          Json?
  pricesAt        DateTime?
  /// Units and value of the stock by state (entered, available, in delivery, returning, lost).
  capital         Json?
  capitalAt       DateTime?
  /// Where the next incremental read of fees and payouts starts.
  feesSyncedAt    DateTime?
  payoutsSyncedAt DateTime?
  /// Per part: when it was last read, and why it could not be (no permission, MDM error).
  parts           Json?
  updatedAt       DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// A payout MDM made (or is preparing) to the seller.
model MdmPayout {
  id           String    @id @default(uuid())
  workspaceId  String
  providerId   String
  amount       Int
  currency     String    @default("DZD")
  /// MDM's own status word, kept as sent.
  status       String
  confirmed    Boolean   @default(false)
  storeNames   String?
  /// What the payout is made of, by MDM line type: { items: [{ type, count, total, grossTotal }], taxes }.
  breakdown    Json?
  /// When `breakdown` was read; cleared when MDM changes the payout, so it is read again.
  breakdownAt  DateTime?
  mdmCreatedAt DateTime
  mdmUpdatedAt DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerId])
  @@index([workspaceId, mdmCreatedAt])
}

/// One line of MDM's seller account: money collected for an order, or a fee MDM charged for it.
model MdmFee {
  id           String   @id @default(uuid())
  workspaceId  String
  providerId   String
  /// What MDM says the line is about (a parcel or an order, by MDM's tracking ID).
  entityId     String?
  type         String
  subType      String?
  amount       Int
  grossAmount  Int?
  taxes        Int?
  currency     String   @default("DZD")
  status       String
  /// MDM's payout this line was paid in, once it is.
  payoutId     String?
  parcelId     String?
  orderId      String?
  mdmCreatedAt DateTime
  mdmUpdatedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parcel    Parcel?   @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, providerId])
  @@index([workspaceId, mdmCreatedAt])
  @@index([workspaceId, type])
  @@index([workspaceId, payoutId])
  @@index([parcelId])
  @@index([orderId])
}

/// Stock of one product variant at MDM, as of the last sync.
model MdmStockItem {
  id            String    @id @default(uuid())
  workspaceId   String
  /// MDM's variant ID.
  providerId    String
  mdmProductId  String
  productName   String
  variantName   String?
  sku           String?
  sellingPrice  Int?
  purchasePrice Int?
  currency      String    @default("DZD")
  archived      Boolean   @default(false)
  totalInbound  Int       @default(0)
  incoming      Int       @default(0)
  available     Int       @default(0)
  processing    Int       @default(0)
  inDelivery    Int       @default(0)
  delivered     Int       @default(0)
  returning     Int       @default(0)
  returned      Int       @default(0)
  damaged       Int       @default(0)
  discharged    Int       @default(0)
  lost          Int       @default(0)
  /// Null until MDM answered the stock read for this variant.
  stockAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerId])
}

/// Stock sent into MDM's warehouse (a check-in): what was expected and what arrived.
model MdmStockArrival {
  id            String   @id @default(uuid())
  workspaceId   String
  providerId    String
  status        String
  operation     String?
  /// [{ name, sku, expected }]
  products      Json
  expectedUnits Int      @default(0)
  receivedUnits Int      @default(0)
  damagedUnits  Int      @default(0)
  mdmCreatedAt  DateTime
  mdmUpdatedAt  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerId])
  @@index([workspaceId, mdmCreatedAt])
}

model Creative {
  id                 String     @id @default(uuid())
  workspaceId        String
  platform           AdPlatform @default(META)
  externalCreativeId String
  normalizedKey      String
  name               String?
  campaignId         String?
  campaignName       String?
  adsetName          String?
  productId          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  attributions Attribution[]
  adSpend      AdSpend[]

  @@unique([workspaceId, platform, externalCreativeId])
  @@index([workspaceId, normalizedKey])
}

model AdSpend {
  id                 String     @id @default(uuid())
  workspaceId        String
  platform           AdPlatform @default(META)
  source             String     @default("META_CSV")
  date               DateTime
  campaignId         String?
  campaignName       String?
  adsetId            String?
  adsetName          String?
  adId               String?
  adName             String?
  externalCreativeId String?
  /// Null = unmatched spend, preserved for review rather than dropped.
  creativeId         String?
  /// Spend in the workspace currency (converted when the export used another currency).
  spend              Int
  currency           String     @default("DZD")
  originalSpend      Int?
  originalCurrency   String?
  /// Units of workspace currency per 1 unit of originalCurrency, as entered at import time.
  fxRate             Float?
  impressions        Int?
  clicks             Int?
  sourceRowHash      String
  importBatchId      String?
  /// Meta ad account (act_…) for rows read from the Meta API.
  adAccountId        String?
  /// Set on CSV rows once the Meta API has the same ad and day; reports then count the API row only.
  supersededAt       DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creative    Creative?    @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, source, sourceRowHash])
  @@index([workspaceId, adId, date])
  @@index([workspaceId, date])
  @@index([workspaceId, creativeId, date])
}

model Expense {
  id                String            @id @default(uuid())
  workspaceId       String
  date              DateTime
  category          ExpenseCategory
  /// Always in the workspace currency (converted when entered in another currency).
  amount            Int
  currency          String            @default("DZD")
  /// Set when entered in another currency: the amount as entered (minor units of
  /// originalCurrency) and the rate used, in workspace currency per 1 unit.
  originalAmount    Int?
  originalCurrency  String?
  fxRate            Float?
  description       String?
  allocation        ExpenseAllocation @default(GLOBAL)
  productId         String?
  costType          CostType          @default(FIXED)
  bankTransactionId String?           @unique
  /// A category the business made; `category` stays OTHER then.
  customCategoryId  String?
  importBatchId     String?
  /// Dedup key for imported expenses (null for manual entries).
  sourceRowHash     String?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product         Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  bankTransaction BankTransaction?       @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  importBatch     ImportBatch?           @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  customCategory  CustomExpenseCategory? @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, sourceRowHash])
  @@index([workspaceId, date])
  @@index([workspaceId, category])
  @@index([workspaceId, productId])
}

/// An expense category a business made for itself (next to the built-in ones).
model CustomExpenseCategory {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  recurring RecurringExpense[]

  @@unique([workspaceId, name])
}

/// An expense that repeats (rent, salaries, a subscription). No expense rows are written for it:
/// reports spread it over the days it covers (src/domain/recurring.ts), so every period gets its share.
model RecurringExpense {
  id               String            @id @default(uuid())
  workspaceId      String
  name             String
  category         ExpenseCategory
  customCategoryId String?
  /// For one period of `frequency`, in the workspace currency.
  amount           Int
  currency         String            @default("DZD")
  originalAmount   Int?
  originalCurrency String?
  fxRate           Float?
  frequency        ExpenseFrequency
  /// The first day it counts, at noon UTC like expense dates.
  startDate        DateTime
  /// The last day it counts. Null while it goes on.
  endDate          DateTime?
  allocation       ExpenseAllocation @default(GLOBAL)
  productId        String?
  costType         CostType          @default(FIXED)
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product        Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  customCategory CustomExpenseCategory? @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

/// Bank rows land here first and do not affect profit until categorized or excluded.
model BankTransaction {
  id            String           @id @default(uuid())
  workspaceId   String
  date          DateTime
  description   String?
  amount        Int
  currency      String           @default("DZD")
  reference     String?
  rowHash       String
  reviewStatus  BankReviewStatus @default(PENDING)
  importBatchId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expense     Expense?
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, rowHash])
  @@index([workspaceId, date])
  @@index([workspaceId, reviewStatus])
}

model ImportBatch {
  id            String       @id @default(uuid())
  workspaceId   String
  kind          ImportKind
  status        ImportStatus @default(PREVIEW)
  /// e.g. SHOPIFY, EASYSELL, META_CSV
  source        String?
  fileName      String
  fileSize      Int
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  duplicateRows Int          @default(0)
  updatedRows   Int          @default(0)
  errorRows     Int          @default(0)
  columnMapping Json?
  /// Import options (date format, FX rate, defaults) and a summary of warnings.
  options       Json?
  summary       Json?
  createdById   String?
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  errors           ImportRowError[]
  orders           Order[]
  adSpend          AdSpend[]
  expenses         Expense[]
  bankTransactions BankTransaction[]

  @@index([workspaceId, kind, createdAt])
}

model ImportRowError {
  id          String   @id @default(uuid())
  workspaceId String
  batchId     String
  rowNumber   Int
  field       String?
  message     String
  rawRow      Json?
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([workspaceId, createdAt])
}

model MetricSnapshot {
  id          String   @id @default(uuid())
  workspaceId String
  kind        String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, periodStart, periodEnd])
  @@index([periodStart])
}

model SimulatorScenario {
  id          String   @id @default(uuid())
  workspaceId String
  productId   String?
  name        String
  /// Zod-validated simulator inputs (money in minor units, probabilities 0–1).
  inputs      Json
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

/// A Meta ad account the workspace's token can read. New accounts are synced by default.
model AdAccount {
  id               String     @id @default(uuid())
  workspaceId      String
  platform         AdPlatform @default(META)
  /// "act_<id>"
  externalId       String
  name             String?
  currency         String?
  timezone         String?
  /// Meta's account_status (1 = active, 2 = disabled, 101 = closed, …).
  accountStatus    Int?
  enabled          Boolean    @default(true)
  /// The saved token (Business Manager) that reads this account. Null when no saved token can see it.
  tokenId          String?
  /// Last time a token could see this account.
  lastSeenAt       DateTime?
  lastSyncedAt     DateTime?
  lastError        String?
  /// Product the account's campaigns count for unless a campaign is linked to its own product.
  defaultProductId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  token          MetaToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  defaultProduct Product?   @relation(fields: [defaultProductId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, platform, externalId])
  @@index([tokenId])
}

/// An ad campaign, known from Meta's campaign list or from ad spend rows. Its product link
/// decides which product its spend and ads count for.
model Campaign {
  id              String     @id @default(uuid())
  workspaceId     String
  platform        AdPlatform @default(META)
  /// The platform's campaign ID.
  externalId      String
  name            String?
  /// "act_<id>" of the ad account running it. Null when only known from a CSV without it.
  adAccountId     String?
  /// Meta's effective_status (ACTIVE, PAUSED, …), or NOT_LISTED once Meta stops listing it
  /// (archived or deleted). Null = never read from Meta.
  status          String?
  statusCheckedAt DateTime?
  /// Null = the ad account's default product, else no product: its spend counts for none.
  productId       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, adAccountId])
}

/// A read-only Meta access token, usually one per Business Manager. A workspace can save
/// several; the META_ADS IntegrationConnection holds the shared schedule and sync state.
model MetaToken {
  id                    String           @id @default(uuid())
  workspaceId           String
  /// Owner-chosen name, e.g. the Business Manager's name.
  label                 String
  /// AES-256-GCM envelope bound to this workspace and token ID. Never sent to the browser.
  encryptedCredential   String
  keyVersion            Int
  /// e.g. "••••1a2b". Safe to display.
  maskedLabel           String
  status                ConnectionStatus @default(UNTESTED)
  lastTestedAt          DateTime?
  lastError             String?
  credentialUpdatedAt   DateTime         @default(now())
  credentialUpdatedById String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccounts AdAccount[]

  @@index([workspaceId])
}
