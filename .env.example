DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
PII_HASH_SALT="replace-with-random-string"
# Optional: only for running the manual MDM contract check script against your own account.
# The application itself never reads a global MDM key; each workspace saves its own in Settings.
MDM_API_KEY=replace-with-local-development-secret
