DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
PII_HASH_SALT="replace-with-random-string"
# Optional: only for running the manual MDM contract check script against your own account.
# The application itself never reads a global MDM key; each workspace saves its own in Settings.
MDM_API_KEY=replace-with-local-development-secret
# Optional key rotation: set the new key above, bump the version, keep the old key here until
# every credential has been re-saved. Envelopes record which key version encrypted them.
# APP_ENCRYPTION_KEY_VERSION=2
# APP_ENCRYPTION_KEY_PREVIOUS="old-32-byte-base64-key"
# Extra MDM hosts allowed as a base URL (comma separated). api.mdm.express is always allowed.
# MDM_ALLOWED_HOSTS=
# Development only: use the labelled mock adapter for non-demo workspaces. Ignored in production.
# MDM_ADAPTER=mock
# Set to "off" to disable in-process background sync (e.g. when only the standalone worker should run).
# SYNC_BACKGROUND=on
# Set to "off" to keep job processing but leave scheduling to an external cron (see docs/deployment.md).
# SYNC_SCHEDULER=on
# Enables POST/GET /api/cron/sync for an external scheduler. At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=
